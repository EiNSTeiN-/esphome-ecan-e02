packages:
  bare: !include ecan-e02-bare.yaml

# Passive input sampling only. Keep GPIO6-GPIO11 out of this list; those are
# connected to flash on classic ESP32 targets.
ecan_e02:
  id: board
  update_interval: 2s
  probe_pins:
    - GPIO0
    - GPIO4
    - GPIO5
    - GPIO12
    - GPIO13
    - GPIO14
    - GPIO15
    - GPIO16
    - GPIO17
    - GPIO18
    - GPIO23
    - GPIO32
    - GPIO33

