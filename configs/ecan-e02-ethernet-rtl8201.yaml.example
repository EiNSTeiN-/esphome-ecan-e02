packages:
  bare: !include ecan-e02-bare.yaml

# This is the common ESP32 RMII layout, not the confirmed ECAN-E02 layout.
# GPIO23 is traced to the CAN status LED, so replace MDC, MDIO, REF_CLK,
# phy_addr, and any power/reset pin with confirmed traces before flashing.
ethernet:
  type: RTL8201
  mdc_pin: GPIO23
  mdio_pin: GPIO18
  phy_addr: 0
  clk:
    mode: CLK_EXT_IN
    pin: GPIO0
